# Production API auth — generate with: openssl rand -hex 32
CRYPTO_API_KEY=

# Spring profile (production disables dev defaults)
SPRING_PROFILES_ACTIVE=production

# Local file storage for voting artifacts (default)
VOTING_STORAGE_TYPE=local

# Optional: Telegram bot for voting result delivery
# VOTING_TELEGRAM_BOT_TOKEN=

# Optional: Backblaze B2 / S3-compatible storage
# B2_ENDPOINT=
# B2_BUCKET_NAME=
# B2_ACCESS_KEY=
# B2_SECRET_KEY=
# B2_REGION=us-east-1

# Optional: persist crypto keys across restarts (generate once, keep secret)
# CRYPTO_KEYS_SIGNING_PRIVATE_KEY_BASE64=
# CRYPTO_KEYS_TSA_PRIVATE_KEY_BASE64=
# CRYPTO_KEYS_VAULT_KEY_HEX=
